# Contoh .env untuk server produksi. Salin ke .env di server lalu isi nilainya.
# JANGAN commit file .env yang sudah berisi rahasia.

APP_NAME="Perkemahan LT 2"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://daftar.contoh-kwarcab.or.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=perkemahan_lt2
DB_USERNAME=perkemahan_lt2
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Isi bila HTTPS diakhiri di reverse proxy / load balancer (mis. Cloudflare Tunnel, Nginx lain).
TRUSTED_PROXIES=

# Email notifikasi ke pembina (SMTP penyedia email panitia).
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="panitia@contoh-kwarcab.or.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Login Google pembina (Google Cloud Console → OAuth Client ID, jenis Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Admin dibuat dengan: php artisan app:create-admin (biarkan ADMIN_PASSWORD kosong).
ADMIN_NAME="Admin Panitia"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Backup terjadwal (php artisan app:backup). Salin folder ini ke lokasi lain secara rutin.
BACKUP_PATH=/var/backups/perkemahan-lt2
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_FULL=4
BACKUP_MYSQLDUMP=mysqldump
