# Hosting bersama (Hostinger): document root domain adalah folder proyek,
# bukan public/. Semua request dialihkan ke public/ supaya hanya isi public/
# yang bisa diakses dari web (.env, .git, storage, vendor tidak ikut tersaji)
# dan URL aset Vite /build/... mengarah ke public/build/.
<IfModule mod_rewrite.c>
    Options -Indexes
    RewriteEngine On

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Cadangan jika mod_rewrite mati: tolak file tersembunyi seperti .env dan .git.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
